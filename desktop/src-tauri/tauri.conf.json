{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ai-client",
  "version": "0.1.0",
  "identifier": "com.local.aiclient",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../web run dev || pnpm --dir ../web run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --dir ../../web run build || pnpm --dir ../web run build",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "离线 AI 智能体客户端",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../plugins/ppt-master/**/*",
      "../../sidecars/**/*"
    ],
    "externalBin": [
      "binaries/ai-client"
    ]
  }
}

