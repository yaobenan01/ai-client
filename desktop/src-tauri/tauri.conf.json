{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "离线AI智能体客户端",
  "version": "0.1.0",
  "identifier": "com.local.aiclient",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../web",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build --prefix ../web",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "离线 AI 智能体客户端",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "resources": [
      "../plugins/ppt-master/**/*",
      "../sidecars/**/*"
    ],
    "externalBin": [
      "binaries/ai-client"
    ]
  }
}
